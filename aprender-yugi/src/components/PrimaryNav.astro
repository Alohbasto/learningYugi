---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<nav class="primary-nav" aria-label="Secciones">
	<a class="brand" href={baseUrl}>Learning Yugi</a>
	<ul>
		<li><a href={`${baseUrl}estructura_carta`}>Estructura carta</a></li>
		<li><a href={`${baseUrl}estructura_campo`}>Estructura campo</a></li>
		<li><a href={`${baseUrl}fases_turno`}>Fases turno</a></li>
		<li><a href={`${baseUrl}tipo_carta`}>Tipo de carta</a></li>
		<li><a href={`${baseUrl}inicio_novato`}>Inicio novato</a></li>
	</ul>
</nav>

<style>
	.primary-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 16px 20px;
		border-bottom: 1px solid rgba(60, 46, 22, 0.15);
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(6px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.primary-nav .brand {
		font-weight: 700;
		letter-spacing: 0.5px;
		text-decoration: none;
		color: #2b2113;
	}

	.primary-nav ul {
		list-style: none;
		display: flex;
		gap: 14px;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.primary-nav a {
		text-decoration: none;
		color: #5a3f1b;
		font-size: 14px;
		padding: 6px 10px;
		border-radius: 999px;
		border: 1px solid transparent;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.primary-nav a:hover {
		border-color: rgba(90, 63, 27, 0.35);
		background: rgba(250, 246, 238, 0.8);
	}

	@media (max-width: 720px) {
		.primary-nav {
			flex-direction: column;
			align-items: flex-start;
		}

		.primary-nav ul {
			justify-content: flex-start;
		}
	}
</style>