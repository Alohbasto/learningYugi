---
import Layout from '../layouts/Layout.astro';
import PrimaryNav from '../components/PrimaryNav.astro';
import cartaAgua from '../assets/cartas_estructura/carta_agua.png';
import cartaDivino from '../assets/cartas_estructura/carta_divino.png';
import cartaFuego from '../assets/cartas_estructura/carta_fuego.png';
import cartaLuz from '../assets/cartas_estructura/carta_luz.png';
import cartaOscuridad from '../assets/cartas_estructura/carta_oscuridad.png';
import cartaTierra from '../assets/cartas_estructura/carta_tierra.png';
import cartaViento from '../assets/cartas_estructura/carta_viento.png';
import cartaOverframe from '../assets/cartas_estructura/overframe.png';
import iconAgua from '../assets/icono_atributo/Agua.webp';
import iconDivinidad from '../assets/icono_atributo/Divinidad.webp';
import iconFuego from '../assets/icono_atributo/Fuego.webp';
import iconLuz from '../assets/icono_atributo/Luz.webp';
import iconOscuridad from '../assets/icono_atributo/Oscuridad.webp';
import iconTierra from '../assets/icono_atributo/Tierra.webp';
import iconViento from '../assets/icono_atributo/Viento.webp';

const atributos = [
	{ nombre: 'Agua', icono: iconAgua.src, carta: cartaAgua.src },
	{ nombre: 'Divinidad', icono: iconDivinidad.src, carta: cartaDivino.src },
	{ nombre: 'Fuego', icono: iconFuego.src, carta: cartaFuego.src },
	{ nombre: 'Luz', icono: iconLuz.src, carta: cartaLuz.src },
	{ nombre: 'Oscuridad', icono: iconOscuridad.src, carta: cartaOscuridad.src },
	{ nombre: 'Tierra', icono: iconTierra.src, carta: cartaTierra.src },
	{ nombre: 'Viento', icono: iconViento.src, carta: cartaViento.src },
];
---

<Layout>
	<PrimaryNav />
	<main class="page">
		<section class="card" id="carta">
			<h1>Estructura de carta</h1>
			<p class="hint">Pulsa las areas de la carta para ver informacion detallada.</p>
			<div class="card-image">
				<img
					id="carta-principal"
					src={cartaAgua.src}
					alt="Carta de ejemplo"
					usemap="#image-map"
					loading="eager"
					fetchpriority="high"
				/>
				<map name="image-map">
					<area
						target=""
						alt="nombre_carta"
						title="nombre_carta"
						href="#nombre"
						coords="250,49,2,0"
						shape="rect"
					/>
					<area
						target=""
						alt="atributo_carta"
						title="atributo_carta"
						href="#atributos"
						coords="249,6,290,51"
						shape="rect"
					/>
					<area
						target=""
						alt="nivel_carta"
						title="nivel_carta"
						href="#nivel"
						coords="188,51,291,80"
						shape="rect"
					/>
					<area
						target=""
						alt="imagen_carta"
						title="imagen_carta"
						href="#imagen"
						coords="27,73,275,312"
						shape="rect"
					/>
					<area
						target=""
						alt="efecto_carta"
						title="efecto_carta"
						href="#efecto"
						coords="284,383,15,322"
						shape="rect"
					/>
					<area
						target=""
						alt="atk_def_carta"
						title="atk_def_carta"
						href="#atkdef"
						coords="19,386,288,426"
						shape="rect"
					/>
				</map>
			</div>
			<div class="info" id="imagen" aria-live="polite">
				<p>Elige como ver la carta:</p>
				<div class="info-actions">
					<button
						type="button"
						class="info-button info-swap"
						data-carta={cartaAgua.src}
						data-nombre="Normal"
					>
						Normal
					</button>
					<button
						type="button"
						class="info-button info-swap"
						data-carta={cartaOverframe.src}
						data-nombre="Overframe"
					>
						Overframe
					</button>
				</div>
			</div>
			<div class="info" id="nombre" aria-live="polite">
				<p>
					Aqui se muestra el nombre de la carta. Es muy importante ya que hay cartas que
					dependen del nombre de la misma.
				</p>
			</div>
			<div class="info" id="nivel" aria-live="polite">
				<p>Este es el nivel de la carta va desde el 1 al 12.</p>
			</div>
			<div class="info" id="efecto" aria-live="polite">
				<p>
					Aqui aparece el texto de efecto que explica que hace la carta en el juego,
					incluyendo condiciones, costos y como interactua con las reglas cuando se activa
					o aplica su efecto.
				</p>
			</div>
			<div class="info" id="atkdef" aria-live="polite">
				<p>Es el ataque y defensa de la carta.</p>
			</div>
		</section>

		<section id="atributos" class="atributos" aria-live="polite">
			<div class="atributos-header">
				<h2>Iconos de atributo</h2>
				<a href="#carta" class="close">Cerrar</a>
			</div>
			<div class="atributos-grid">
				{atributos.map((atributo) => (
					<figure class="atributo" aria-label={atributo.nombre}>
						<button
							type="button"
							class="atributo-button"
							data-carta={atributo.carta}
							data-nombre={atributo.nombre}
						>
							<img src={atributo.icono} alt={atributo.nombre} loading="lazy" />
						</button>
						<figcaption>{atributo.nombre}</figcaption>
					</figure>
				))}
			</div>
		</section>
	</main>
</Layout>

<script>
	const cartaPrincipal = document.querySelector('#carta-principal');
	const botones = document.querySelectorAll('.atributo-button');
	const botonesInfo = document.querySelectorAll('.info-swap');

	if (cartaPrincipal instanceof HTMLImageElement) {
		botones.forEach((boton) => {
			boton.addEventListener('click', () => {
				const nuevaCarta = boton.getAttribute('data-carta');
				const nombre = boton.getAttribute('data-nombre');

				if (nuevaCarta) {
					cartaPrincipal.src = nuevaCarta;
					if (nombre) {
						cartaPrincipal.alt = `Carta atributo ${nombre}`;
					}
				}
			});
		});

		botonesInfo.forEach((boton) => {
			boton.addEventListener('click', () => {
				const nuevaCarta = boton.getAttribute('data-carta');
				const nombre = boton.getAttribute('data-nombre');

				if (nuevaCarta) {
					cartaPrincipal.src = nuevaCarta;
					if (nombre) {
						cartaPrincipal.alt = `Carta atributo ${nombre}`;
					}
				}
			});
		});
	}
</script>

<style>
	:global(body) {
		font-family: 'Trebuchet MS', 'Segoe UI', Tahoma, sans-serif;
		background: radial-gradient(circle at top, #f7f2e8, #e6dccb 70%);
		color: #1d1a14;
	}

	.page {
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 20px 12px 64px;
		gap: 24px;
	}

	.card {
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(60, 46, 22, 0.15);
		border-radius: 20px;
		box-shadow:
			0 20px 40px rgba(55, 38, 18, 0.15),
			inset 0 1px 0 rgba(255, 255, 255, 0.8);
		padding: 20px;
		max-width: 380px;
		width: 100%;
		text-align: center;
	}

	.card h1 {
		margin: 0 0 8px;
		font-size: 22px;
		letter-spacing: 0.5px;
	}

	.hint {
		margin: 0 0 14px;
		font-size: 13px;
		color: #51452e;
		line-height: 1.4;
	}

	.card-image {
		display: grid;
		place-items: center;
	}

	.info {
		display: none;
		margin-top: 16px;
		padding: 12px 16px;
		background: rgba(248, 241, 229, 0.9);
		border-radius: 12px;
		border: 1px solid rgba(90, 63, 27, 0.2);
		font-size: 13px;
		color: #3f2f1b;
		text-align: center;
		line-height: 1.5;
	}

	.info p {
		margin: 0;
	}

	.info:target {
		display: grid;
		gap: 10px;
		animation: fadeIn 200ms ease-out;
	}

	.info-actions {
		display: flex;
		justify-content: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.info-button {
		text-decoration: none;
		font-size: 13px;
		padding: 8px 16px;
		border-radius: 999px;
		border: 1px solid rgba(90, 63, 27, 0.3);
		color: #5a3f1b;
		background: #fffaf2;
		transition: background 0.2s ease, color 0.2s ease;
		cursor: pointer;
		min-height: 36px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.info-button:hover,
	.info-button:active {
		background: #5a3f1b;
		color: #fff5e6;
	}

	.card-image img {
		max-width: 100%;
		height: auto;
		border-radius: 10px;
		box-shadow: 0 10px 24px rgba(29, 26, 20, 0.25);
	}

	.atributos {
		display: none;
		width: min(900px, 100%);
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(60, 46, 22, 0.15);
		border-radius: 20px;
		box-shadow:
			0 20px 40px rgba(55, 38, 18, 0.12),
			inset 0 1px 0 rgba(255, 255, 255, 0.8);
		padding: 20px;
		gap: 16px;
	}

	.atributos:target {
		display: grid;
		animation: fadeIn 240ms ease-out;
	}

	.atributos-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.atributos-header h2 {
		margin: 0;
		font-size: 18px;
	}

	.close {
		text-decoration: none;
		font-size: 13px;
		color: #5a3f1b;
		border: 1px solid rgba(90, 63, 27, 0.3);
		padding: 8px 14px;
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease;
		white-space: nowrap;
		min-height: 36px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.close:hover,
	.close:active {
		background: #5a3f1b;
		color: #fff5e6;
	}

	.atributos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
		gap: 12px;
		margin-top: 8px;
	}

	.atributo {
		display: grid;
		place-items: center;
		gap: 6px;
		padding: 10px 8px;
		background: rgba(250, 246, 238, 0.8);
		border-radius: 14px;
		border: 1px solid rgba(60, 46, 22, 0.12);
		margin: 0;
	}

	.atributo-button {
		display: grid;
		place-items: center;
		width: 100%;
		border: none;
		background: transparent;
		padding: 8px;
		cursor: pointer;
		transition: transform 0.2s ease;
		border-radius: 12px;
	}

	.atributo-button:hover {
		transform: scale(1.05);
	}

	.atributo-button:active {
		transform: scale(0.98);
	}

	.atributo-button:focus-visible {
		outline: 2px solid #5a3f1b;
		outline-offset: 2px;
		border-radius: 12px;
	}

	.atributo img {
		width: 56px;
		height: 56px;
		object-fit: contain;
	}

	.atributo figcaption {
		font-size: 12px;
		color: #3f2f1b;
		text-align: center;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 640px) {
		.page {
			padding: 16px 10px 48px;
			gap: 20px;
		}

		.card {
			padding: 16px;
			border-radius: 16px;
		}

		.card h1 {
			font-size: 20px;
		}

		.hint {
			font-size: 12px;
		}

		.info {
			padding: 10px 12px;
			font-size: 12px;
		}

		.info-button {
			font-size: 12px;
			padding: 7px 14px;
			min-height: 34px;
		}

		.atributos {
			padding: 16px;
			border-radius: 16px;
		}

		.atributos-header h2 {
			font-size: 16px;
		}

		.close {
			font-size: 12px;
			padding: 7px 12px;
			min-height: 34px;
		}

		.atributos-grid {
			grid-template-columns: repeat(auto-fit, minmax(85px, 1fr));
			gap: 10px;
		}

		.atributo {
			padding: 8px 6px;
			gap: 4px;
		}

		.atributo-button {
			padding: 6px;
		}

		.atributo img {
			width: 48px;
			height: 48px;
		}

		.atributo figcaption {
			font-size: 11px;
		}
	}

	@media (max-width: 400px) {
		.page {
			padding: 12px 8px 40px;
		}

		.card {
			padding: 14px;
		}

		.card h1 {
			font-size: 18px;
		}

		.atributos-grid {
			grid-template-columns: repeat(auto-fit, minmax(75px, 1fr));
			gap: 8px;
		}

		.atributo-button {
			padding: 4px;
		}

		.atributo img {
			width: 40px;
			height: 40px;
		}

		.atributo figcaption {
			font-size: 10px;
		}
	}

	@media (min-width: 641px) {
		.page {
			padding: 32px 16px 64px;
		}

		.card {
			padding: 24px;
		}

		.card h1 {
			font-size: 24px;
		}

		.hint {
			font-size: 14px;
		}

		.info {
			font-size: 14px;
		}

		.atributos {
			padding: 24px;
		}

		.atributos-header h2 {
			font-size: 20px;
		}

		.atributo img {
			width: 64px;
			height: 64px;
		}

		.atributos-grid {
			grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
			gap: 14px;
		}

		.atributo figcaption {
			font-size: 13px;
		}
	}
</style>
